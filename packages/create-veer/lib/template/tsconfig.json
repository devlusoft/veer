{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": [
    ".veer/**/*.d.ts",
    ".veer/typed-router.d.ts",
    "app.vue",
    "pages/**/*.vue",
    "layouts/**/*.vue",
    "components/**/*.vue",
    "composables/**/*.ts",
    "veer.config.ts"
  ]
}
