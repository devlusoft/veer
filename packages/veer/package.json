{
  "name": "@devlusoft/veer",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/client-only": {
      "types": "./dist/components/client-only.d.ts",
      "default": "./dist/components/client-only.js"
    },
    "./config": {
      "types": "./dist/config/define-config.d.ts",
      "default": "./dist/config/define-config.js"
    },
    "./components/veer-root": {
      "types": "./dist/components/veer-root.d.ts",
      "default": "./dist/components/veer-root.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/handler": {
      "types": "./dist/server/handler.d.ts",
      "default": "./dist/server/handler.js"
    },
    "./server/nitro-log-request": {
      "types": "./dist/server/nitro-log-request.d.ts",
      "default": "./dist/server/nitro-log-request.js"
    },
    "./runtime/server/handler": {
      "types": "./dist/server/handler.d.ts",
      "default": "./dist/server/handler.js"
    },
    "./runtime/server-polyfill": {
      "types": "./dist/runtime/server-polyfill.d.ts",
      "default": "./dist/runtime/server-polyfill.js"
    },
    "./runtime/server-head": {
      "types": "./dist/runtime/server-head.d.ts",
      "default": "./dist/runtime/server-head.js"
    },
    "./setup": {
      "types": "./dist/veer-setup.d.ts",
      "default": "./dist/veer-setup.js"
    },
    "./h3": {
      "types": "./dist/h3.d.ts",
      "default": "./dist/h3.js"
    }
  },
  "bin": {
    "veer": "dist/bin/veer.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlusoft/veer.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@unhead/vue": "3.3.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/compiler-sfc": "3.5.38",
    "acorn": "8.17.0",
    "c12": "4.0.0-beta.5",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "devalue": "5.9.0",
    "get-port-please": "3.2.0",
    "magic-string": "0.30.21",
    "nitro": "3.0.260610-beta",
    "ofetch": "2.0.0-alpha.3",
    "unctx": "3.0.0",
    "unplugin": "3.0.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "valibot": "1.4.2",
    "vite-node": "6.0.0",
    "vue-bundle-renderer": "2.3.2"
  },
  "peerDependencies": {
    "vite": "8.2.1",
