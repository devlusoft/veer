    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@unhead/vue": "3.3.1",
    "consola": "3.4.2",
    "devalue": "5.9.0",
    "happy-dom": "21.0.1",
    "ofetch": "2.0.0-alpha.3",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "unctx": "3.0.0",
    "valibot": "1.4.2",
    "vite": "8.2.1",
    "vitest": "4.1.9",
    "vue": "3.5.41",
    "vue-bundle-renderer": "2.3.2",
    "vue-router": "4.6.4"
  }
